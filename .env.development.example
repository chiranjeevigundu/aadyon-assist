# Development environment template — copy to .env on your local dev machine:
#   cp .env.development.example .env
# (or run `just bootstrap-dev`, which does this plus generates secrets/*.txt).
# .env is gitignored; this file documents dev-appropriate defaults only.

# Postgres
POSTGRES_USER=aadyon
POSTGRES_DB=aadyon_assist
# DB password is provided via Docker secret (see secrets/db_password.txt), not here.

# API
API_PORT=8000
TZ=UTC

# --- Auth (multi-user) ---
# Signing key for JWT bearer tokens. REQUIRED for login/signup. Prefer the Docker
# secret secrets/jwt_secret.txt; this env var is the fallback. Generate a strong one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Short-lived in dev is fine; shorten further if you're testing token expiry.
JWT_EXPIRE_MINUTES=43200

# --- Agentic layer (model routing) ---
# Needed to exercise the assistant/agency chat locally. Get a key at openrouter.ai.
# Prefer the Docker secret secrets/openrouter_api_key.txt; this env var is the fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local models via Ollama on the host (install + `ollama serve`). From containers,
# the host is reachable as host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
AGENT_MAX_STEPS=6

# --- Push notifications (self-hosted ntfy) ---
# `just up-dev` doesn't start ntfy/backup by default (dev doesn't need push or
# scheduled backups of throwaway data) — leave blank unless you're testing alerts.
ALERT_DAYS=3
NTFY_TOPIC=
NTFY_PORT=8090
NTFY_BASE_URL=http://localhost:8090

# --- Multi-user (family & friends) ---
APP_PUBLIC_URL=http://localhost:8000
# In dev you may want open signup; set false to skip invite codes locally.
INVITE_REQUIRED=false
# Empty => verify/reset links are logged to stdout (no email sent) — handy in dev.
RESEND_API_KEY=
MAIL_FROM=Aadyon Assist <onboarding@resend.dev>
EMAIL_TOKEN_MINUTES=60
DEFAULT_MONTHLY_TOKEN_BUDGET=0

# --- Document/file storage (cloud-portable) ---
# local  (default): persist uploads under artifacts_dir/uploads on this host.
# s3     : any S3-compatible store — real AWS OR a local emulator. Same code both ways;
#          you switch clouds by editing the S3_* block below, never by touching code.
# mock   : no real I/O (tests only).
# Full guide + copy-paste profiles: docs/cloud-storage.md
STORAGE_BACKEND=local

# ---- S3 config (used only when STORAGE_BACKEND=s3) --------------------------------
# Migrate between clouds by swapping ONE of the two profiles below. Nothing else changes.
#
# Profile A — Floci / LocalStack local emulator (default for local dev):
#   STORAGE_BACKEND=s3
#   S3_ENDPOINT_URL=http://host.docker.internal:4566   # emulator on the host
#   S3_BUCKET_NAME=aadyon-assist
#   S3_REGION=us-east-1
#   # creds: put `test` in secrets/s3_access_key.txt and secrets/s3_secret_key.txt
#
# Profile B — real AWS S3:
#   STORAGE_BACKEND=s3
#   # (leave S3_ENDPOINT_URL unset — that's what makes it target real AWS)
#   S3_BUCKET_NAME=my-real-bucket
#   S3_REGION=us-east-1                                 # the bucket's actual region
#   # creds: real IAM key/secret in secrets/s3_*.txt, OR omit them to use an IAM role
#
# S3_FORCE_PATH_STYLE: auto (default) = path-style when an endpoint is set (emulators),
#   virtual-host for real AWS. Override with true/false only if your store needs it.
# S3_AUTO_CREATE_BUCKET: true (default) creates the bucket on startup if missing.
#   Set false on real AWS if the app's role must not hold CreateBucket.
# S3_ENDPOINT_URL=
# S3_BUCKET_NAME=aadyon-assist
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=auto
# S3_AUTO_CREATE_BUCKET=true

# --- Email ingest --- (optional; leave blank unless testing the connector)
EMAIL_ENC_KEY=
EMAIL_LOOKBACK_DAYS=14
EMAIL_MAX_MESSAGES=40
MS_CLIENT_ID=
MS_TENANT=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Developer surfaces ---
# Dev machine: on, so /data + /docs are available while building.
# false (default) = production UI only. true = also serve the raw table console at
# /data plus FastAPI's /docs, /redoc and /openapi.json, and link them in the nav.
# Leave false on anything internet-facing.
DEV_MODE=true
