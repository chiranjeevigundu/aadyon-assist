# What differs about this product. Everything else lives in floci-lab/bin/deploy-k8s.sh.
PRODUCT="aadyon-assist"
IMAGE_NAME="aadyon-assist-api"
NAMESPACE="aadyon"
WEB_PORT="8000"
NODE_PORT="30080"
# The briefing worker runs as its own Deployment and must roll with the api.
ROLLOUTS="api briefing"
READY_HINT="sign up to create your account."
